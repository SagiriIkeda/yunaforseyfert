{
    "name": "yunaforseyfert",
    "version": "1.1.3",
    "description": "Yunathings for seyfert",
    "main": "./build/index.cjs",
    "module": "./build/index.mjs",
    "types": "./build/index.d.cts",
    "private": true,
    "exports": {
        ".": {
            "types": "./build/index.d.cts",
            "require": "./build/index.cjs",
            "import": "./build/index.mjs",
            "default": "./build/index.cjs"
        }
    },
    "files": [
        "build"
    ],
    "scripts": {
        "bot": "cd bot && tsx watch --env-file=.env .",
        "pkg:pack": "vitest run test && npm run build && tsx src/lib/prepublish.mts && cd .npm && npm pack && echo pkg:pack done",
        "pkg:publish": "cd .npm && npm publish",
        "pkg:publish-dev": "cd .npm && npm publish --tag dev",
        "prepare": "npm run build && npx husky",
        "build": "npx tsdown",
        "lint": "biome lint --write ./src",
        "format": "biome check --write ./src",
        "test": "vitest",
        "tsc:check": "tsc --noEmit",
        "check": "pnpm tsc:check && vitest run test",
        "esbuild": "esbuild src/**/*.ts --outdir=dist --sourcemap=inline --platform=node --format=cjs --target=es2022"
    },
    "keywords": [
        "ArgsParser",
        "CommandsResolver",
        "MessageWatcher",
        "seyfert"
    ],
    "author": "SagiriIkeda",
    "license": "ISC",
    "homepage": "https://github.com/SagiriIkeda/yunaforseyfert#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SagiriIkeda/yunaforseyfert.git"
    },
    "lint-staged": {
        "*.ts": [
            "biome check --write",
            "biome format --write"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@types/node": "^25.9.1",
        "didyoumean2": "^7.0.4",
        "esbuild": "^0.28.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "seyfert": "4.3.1-dev-26073359071.0",
        "tsdown": "^0.22.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    }
}