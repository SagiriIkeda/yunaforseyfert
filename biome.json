{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "suspicious": {
                "noExplicitAny": "off",
                "noConfusingVoidType": "off",
                "noGlobalIsFinite": "off",
                "noGlobalIsNan": "off",
                "noEmptyBlockStatements": "off",
                "noConsole": {
                    "level": "error",
                    "options": { "allow": ["log"] }
                }
            },
            "style": {
                "noNonNullAssertion": "off",
                "noParameterAssign": "off",
                "noInferrableTypes": "off",
                "useNumberNamespace": "off",
                "noDefaultExport": "off",
                "useBlockStatements": "off",
                "useFilenamingConvention": "off",
                "useNamingConvention": "warn",
                "useEnumInitializers": "off"
            },
            "complexity": {
                "noBannedTypes": "off",
                "noForEach": "warn",
                "noExcessiveCognitiveComplexity": {
                    "level": "warn",
                    "options": {
                        "maxAllowedComplexity": 30
                    }
                }
            },
            "correctness": {
                "noNodejsModules": "off",
                "noVoidTypeReturn": "off",
                "noSwitchDeclarations": "off"
            },
            "security": {
                "noGlobalEval": "off"
            },
            "performance": {
                "noBarrelFile": "off"
            }
        }
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/.vscode",
            "!**/node_modules",
            "!**/dist",
            "!**/build"
        ]
    },
    "json": {
        "formatter": {
            "enabled": true,
            "indentWidth": 4,
            "lineWidth": 80
        }
    },
    "formatter": {
        "enabled": true,
        "indentWidth": 4,
        "indentStyle": "space",
        "lineWidth": 140,
        "lineEnding": "crlf",
        "formatWithErrors": true
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "arrowParentheses": "always",
            "bracketSameLine": true,
            "semicolons": "always"
        }
    }
}
